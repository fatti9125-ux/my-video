get used to being vice president."],[81.72,"When Franklin Roosevelt died in April 1945, Truman suddenly inherited a world war."],[88.4,"Roosevelt had barely included him in major decisions and hadn't briefed him on the atomic bomb project."],[93.68,"Truman became president before learning the full details of the weapon he would authorize against Japan."],[98.9,"He later faced an election many expected him to lose, then defeated Thomas Dewey in 1948."],[104.5,"The replacement won a term of his own."]],"words":[["garfield",0,0.0],["lingered",0,0.56],["for",0,0.99],["weeks",0,1.11],["before",0,1.55],["dying",0,1.88],["leaving",0,2.52],["arthur",0,2.83],["with",0,3.17],["the",0,3.34],["office",0,3.5],["and",0,4.02],["a",0,4.18],["deeply",0,4.23],["uncomfortable",0,4.76],["association",0,5.45],["arthur",1,6.54],["had",1,6.86],["risen",1,6.98],["through",1,7.27],["a",1,7.4],["system",1,7.45],["that",1,7.86],["rewarded",1,7.98],["allies",1,8.46],["with",1,8.99],["government",1,9.12],["jobs",1,9.49],["he",2,10.21],["surprised",2,10.3],["critics",2,10.8],["by",2,11.16],["signing",2,11.31],["the",2,11.71],["pendleton",2,11.78],["act",2,12.28],["requiring",2,12.59],["competitive",2,13.14],["examinations",2,13.64],["for",2,14.43],["certain",2,14.56],["federal",2,14.89],["positions",2,15.24],["the",3,16.23],["politician",3,16.32],["associated",3,16.95],["with",3,17.63],["handing",3,17.81],["out",3,18.18],["jobs",3,18.32],["helped",3,18.8],["change",3,19.02],["how",3,19.51],["those",3,19.83],["jobs",3,20.05],["were",3,20.38],["filled",3,20.46],["theodore",4,21.34],["roosevelt's",4,21.73],["party",4,22.22],["bosses",4,22.53],["had",4,22.99],["their",4,23.13],["own",4,23.28],["staffing",4,23.63],["solution",4,24.07],["new",5,25.08],["york",5,25.18],["boss",5,25.41],["thomas",5,25.78],["platt",5,26.19],["helped",5,26.44],["push",5,26.78],["the",5,27.04],["troublesome",5,27.13],["governor",5,27.68],["toward",5,28.03],["the",5,28.23],["vice",5,28.3],["presidency",5,28.59],["getting",5