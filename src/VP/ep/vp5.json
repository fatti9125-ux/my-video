ot it."],[56.74,"Their attempts produced a whole different collection of political disasters."]],"words":[["joe",0,0.0],["biden",0,0.29],["needed",0,0.67],["three",0,1.04],["presidential",0,1.44],["campaigns",0,1.92],["his",1,2.8],["bids",1,2.96],["for",1,3.19],["the",1,3.27],["1988",1,3.34],["and",1,4.27],["2008",1,4.38],["nominations",1,5.06],["failed",1,5.71],["but",1,6.33],["barack",1,6.55],["obama",1,6.94],["chose",1,7.45],["him",1,7.8],["as",1,8.02],["his",1,8.16],["running",1,8.27],["mate",1,8.54],["biden",2,9.23],["served",2,9.54],["eight",2,9.99],["years",2,10.19],["as",2,10.46],["vice",2,10.57],["president",2,10.8],["spent",2,11.45],["four",2,11.71],["years",2,12.07],["out",2,12.36],["of",2,12.44],["office",2,12.52],["then",2,12.96],["defeated",2,13.2],["donald",2,13.65],["trump",2,13.9],["in",2,14.17],["2020",2,14.26],["he",3,15.28],["took",3,15.4],["office",3,15.65],["at",3,16.06],["seventy-eight",3,16.15],["setting",3,16.8],["the",3,17.2],["age",3,17.27],["record",3,17.59],["at",3,17.89],["the",3,17.95],["time",3,18.03],["his",4,18.88],["presidency",4,19.05],["included",4,19.69],["a",4,20.16],["bipartisan",4,20.42],["infrastructure",4,21.02],["law",4,21.67],["and",4,22.17],["he",4,22.3],["ended",4,22.49],["his",4,22.75],["reelection",4,22.95],["campaign",4,23.53],["in",4,24.05],["2024",4,24.12],["decades",5,25.51],["after",5,26.02],["his",5,26.22],["first",5,26.34],["attempt",5,26.61],["he'd",5,27.21],["served",5,27.39],["a",5,27.73],["full",5,27.78],["term",5,28.1],["that",6,28.89],["makes",6,29.05],["fifteen",6,29.28],["eight",7,30.22],["first",7,30.46],["became",7,30.7],["president",7,31.04],["because",7,31.58],["a",7,31.89],["president",7,31.93],["died",7,32.39],["ford",8,33.14],["got",8,33.39],["there",8,33.67],["through",8,33.82],["a",8,34.01],["resignation",8,34.04],["six",9,34.96],["reached",9,35.3],["it",9,35.63],["by",9,35.77],["winning",9,35.9],["an",9,36.25],["election",9,36.31],["including",9,36.94],["nixon",9,37.51],["and",9,37.82],["biden