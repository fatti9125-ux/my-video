5.24,85.74,86.31,86.88,87.57,88.29,88.85,89.64,90.5,91.11,91.62,92.72,93.36,94.14,94.67,95.18,95.65,96.15,97.11,97.66,98.33,99.05,99.78,100.49,101.42,101.95,102.42,102.98,103.44,104.19],"lines":[[0.0,"Harrison died after thirty-one days in office."],[2.97,"Nobody had dealt with a dead president before, and some argued that Tyler was only supposed to exercise presidential powers temporarily."],[10.92,"Tyler insisted he had become president outright and took a new oath."],[15.1,"His decision established the precedent later vice presidents followed."],[18.49,"His own party soon regretted having him."],[21.32,"Tyler vetoed its banking plans, nearly his entire cabinet resigned, and the Whigs expelled him."],[26.44,"He kept the presidency and lost the party that put him there."],[29.48,"Millard Fillmore got his turn when Zachary Taylor died in 1850."],[33.57,"The country was fighting over slavery and the territories taken from Mexico."],[37.52,"Fillmore backed the Compromise of 1850 and signed its separate measures into law."],[42.19,"California entered as a free state, but the package also included a stronger Fugitive Slave Act, helping enslavers seize people who had escaped, even in free states."],[51.44,"The supposed settlement deepened anger over slavery."],[54.55,"Fillmore finished Taylor's term, but his party picked someone else for the next election."],[59.64,"Then came Andrew Johnson, whose start as vice president was already a disaster."],[64.65,"At his inauguration in March 1865, Johnson had been drinking and delivered a rambling speech while Lincoln watched."],[71.54,"About six weeks later, Lincoln was dead, and that same man was president."],[75.91,"Johnson clashed with Congress over Reconstruction and vetoed a civil rights bill."],[80.83,"The fight eventually produced the first presidential impeachment."],[84.46,"At his Senate trial, the votes for conviction fell one short of the number needed to remove him."],[89.58,"His presidency survived by a single vote."],[92.54,"Chester A. Arthur's promotion came with a deeply uncomfortable association."],[96.86,"When James Garfield was shot in 1881, the gunman declared his support for Arthur's Republican faction and announced that Arthur would be president."]],"words":[["harrison",0,0.0],["died",0,0.53],["after",0,0.87],["thirty-one",0,1.15],["days",0,1.85],["in",0,2.13],["office",0,2.2],["nobody",1,2.97],["had",1,3.61],["dealt",1,3.8],["with",1,4.07],["a",1,4.17],["dead",1,4.22],["president",1,4.52],["before",1,4.94],["and",1,5.51],["some",1,5.65],["argued",1,5.91],["that",1,6.33],["tyler",1,6.43],["was",1,6.77],["only",1,7.01],["supposed",1,7.31],["to",1,7.75],["exercise",1,7.87],["presidential",1,8.56],["powers",1,9.1],["temporarily",1,9.6],["tyler",2,10.92],["insisted",2,11.28],["he",2,11.85],["had",2,12.05],["become",2,12.15],["president",2,12.47],["outright",2,13.06],["and",2,13.7],["took",2,13.81],["a",2,14.01],["new",2,14.05],["oath",2,14.32],["his",3,15.1],["decision",3,15.26],["established",3,15.68],["the",3,16.18],["precedent",3,16.26],["later",3,16.7],["vice",3,17.17],["presidents",3,17.42],["followed",3,17.84],["his",4,18.49],["own",4,18.66],["party",4,18.89],["soon",4,19.33],["regretted",4,19.72],["having",4,20.23],["him",4,20.61],["tyler",5,21.32],["vetoed",5,21.7],["its",5,22.12],["banking",5,22.27],["plans",5,22.61],["nearly",5,23.06],["his",5,23.39],["entire",5,23.59],["cabinet",5,24.05],["resigned",5,24.51],["and",5,25.13],["the",5,25.28],["whigs",5,25.34],["expelled",5,25.64],["him",5,26.07],["he",6,26.44],["kept",6,26.55],["the",6,26.79],["presidency",6,26.87],["and",6,27.57],["lost",6,27.68],["the",6,27.96],["party",6,28.03],["that",6,28.35],["put",6,28.46],["him",6,28.61],["there",6,28.74],["millard",7,29.48],["fillmore",7,29.83],["got",7,30.33],["his",7,30.56],["turn",7,30.69],["when",7,31.04],["zachary",7,31.17],["taylor",7,31.58],["died",7,31.97],["in",7,32.29],["1850",7,32.41],["the",8,33.57],["country",8,33.68],["was",8,34.09],["fighting",8,34.28],["o